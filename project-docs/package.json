{
  "name": "ai-agentic-sdd-engineering-harness-docs",
  "version": "2.5.0",
  "type": "module",
  "description": "Tablero interactivo, base de conocimiento y arnés de pruebas para SDD",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test tests/unit/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "build": "npx esbuild src/main.js --bundle --outfile=dist/app.bundle.js --format=iife",
    "cli": "node cli.js",
    "sync": "node sync-data.js",
    "start": "node serve.js",
    "test:acceptance": "npx playwright test",
    "test:whitebox": "node --test tests/whitebox/**/*.test.js",
    "test:blackbox": "node --test tests/blackbox/**/*.test.js",
    "test:system": "node --test tests/system/**/*.test.js",
    "test:load": "node --test tests/load/**/*.test.js",
    "evidence": "node scripts/capture-evidence.js",
    "verify": "bash verify.sh",
    "test:all": "node --test tests/unit/**/*.test.js tests/e2e/**/*.test.js tests/whitebox/**/*.test.js tests/blackbox/**/*.test.js tests/system/**/*.test.js tests/load/**/*.test.js && npx playwright test"
  },
  "keywords": [
    "antigravity",
    "sdd",
    "spec-driven-development",
    "ai-agents",
    "harness",
    "opencode",
    "github-copilot"
  ],
  "author": "Google Antigravity & Harness Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.25.0"
  }
}
