        <mxCell id="n_3" value="&lt;b&gt;Arquitecto / Curador Documental&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona — ACT-01]&lt;/i&gt;&lt;br&gt;Estructura libros Markdown, aprueba flujo editorial (PUBLISHED) y cura Context Bundles." style="whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
