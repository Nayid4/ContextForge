        <mxCell id="n_4" value="&lt;b&gt;Desarrollador de Software&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona — ACT-02]&lt;/i&gt;&lt;br&gt;Ejecuta búsqueda híbrida, consulta chat RAG con citas verificables y comenta secciones." style="whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
