        </mxCell>
        <mxCell id="n_7" value="&lt;b&gt;ContextForge: Plataforma Soberana &amp;amp; SDK Reutilizable (v2.0)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de Software — Python 3.11+ / FastAPI / Clean Architecture]&lt;/i&gt;&lt;br&gt;Centraliza documentación Docs-as-Code con versionado y flujo editorial, ejecuta búsqueda híbrida (BM25 + Vectorial con fusión RRF), provee generación RAG con citas exactas, compila Context Bundles por presupuesto de tokens y expone API pública SDK, interfaz Web colaborativa y servidor MCP." style="whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="375" width="680" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_8" value="&lt;b&gt;Repositorio Git / Filesystem Local&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema Externo — ACT-06]&lt;/i&gt;&lt;br&gt;Archivos Markdown (.md) con frontmatter YAML y anexos técnicos (PDF, DOCX, Draw.io)." style="whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
