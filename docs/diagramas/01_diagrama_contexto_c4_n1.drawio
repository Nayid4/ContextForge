        <mxCell id="n_2" value="&lt;b&gt;Diagrama de Contexto del Sistema — ContextForge (Modelo C4 - Nivel 1)&lt;/b&gt;&lt;br&gt;Frontera sociotécnica entre consumidores humanos/agentes IA, plataforma soberana ContextForge y sistemas externos" style="whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=15;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
