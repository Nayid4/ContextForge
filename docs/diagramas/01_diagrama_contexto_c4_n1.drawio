        <mxCell id="n_6" value="&lt;b&gt;Agentes de IA / IDEs / Apps Python&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema Consumidor — ACT-03]&lt;/i&gt;&lt;br&gt;Cursor, Copilot, Claude, Antigravity o apps que usan SDK contextforge y servidor MCP." style="whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
