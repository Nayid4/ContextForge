        <mxCell id="n_2" value="&lt;b&gt;Diagrama de Contenedores — Plataforma y Componente ContextForge (Modelo C4 - Nivel 2)&lt;/b&gt;&lt;br&gt;Descomposición en contenedores ejecutables, núcleo reutilizable sin dependencias, almacenes persistentes y canales de integración" style="whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=15;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
