        <mxCell id="n_3" value="&lt;b&gt;Usuarios Humanos (Curador / Desarrollador / Admin)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Navegador Web Moderno (HTTPS / SSE / WSS)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
