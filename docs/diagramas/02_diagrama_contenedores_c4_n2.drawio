        <mxCell id="n_4" value="&lt;b&gt;Agentes de IA, IDEs (Cursor/Copilot/Claude) y Aplicaciones Python Anfitrionas&lt;/b&gt;&lt;br&gt;&lt;i&gt;Clientes MCP JSON-RPC 2.0 y Consumidores directos del Paquete Python contextforge&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
