        <mxCell id="n_6" value="&lt;b&gt;Aplicación Web Screaming Architecture&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Jinja2 + HTMX + Tailwind CSS v4]&lt;/i&gt;&lt;br&gt;Explorador, Editor dividido con ETag, Chat RAG SSE, Compilador de Bundles y Panel Settings." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
