        <mxCell id="n_7" value="&lt;b&gt;Hub Colaborativo en Tiempo Real&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: FastAPI WebSockets]&lt;/i&gt;&lt;br&gt;Salas por proyecto y documento, presencia en vivo, alertas de edición e hilos de comentarios." style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
