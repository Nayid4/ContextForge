        </mxCell>
        <mxCell id="n_8" value="&lt;b&gt;Servidor Universal MCP (/mcp)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: FastMCP / JSON-RPC 2.0 + Stdio]&lt;/i&gt;&lt;br&gt;Expone search_project_context, get_document_full y list_project_structure a agentes IA." style="whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="875" y="305" width="395" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_9" value="&lt;b&gt;Servidor API REST/SSE &amp;amp; Bus CQRS&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Python 3.11+ / FastAPI]&lt;/i&gt;&lt;br&gt;Casos de uso granulares (Commands/Queries), Auth OAuth2/JWT + API-Key RBAC, errores RFC 7807, política sovereign_only y bóveda AES-256-GCM." style="whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="525" width="395" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n_10" value="&lt;b&gt;Componente Reutilizable contextforge&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Paquete Python Instalable — 0 Dependencias]&lt;/i&gt;&lt;br&gt;API pública (ContextForge, Builder, 8 Contratos OCP) + motor privado _internal (RuleChain, Chunkers, BM25/Vector, RRF, Exporters, AuditDecorator)." style="whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#0F766E;fontColor=#0F172A;fontSize=12;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
