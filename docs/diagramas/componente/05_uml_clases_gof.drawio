        <mxCell id="n_2" value="&lt;b&gt;Diagrama de Clases UML — ContextForge (v1.0.0) con Patrones GoF Principales&lt;/b&gt;&lt;br&gt;Diseño pragmático (sin sobreingeniería): 1 patrón GoF principal por categoría — Builder (Creacional), Facade (Estructural) y Strategy (Comportamiento)" style="whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=15;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1840" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_4" value="&lt;b&gt;&amp;lt;&amp;lt;GoF Creacional: Builder&amp;gt;&amp;gt;&lt;br&gt;ContextForgeBuilder&lt;/b&gt;&lt;hr&gt;- _config: ContextForgeConfig&lt;br&gt;- _lexical_store: ILexicalStore | None&lt;br&gt;- _llm_provider: ILLMProvider | None&lt;hr&gt;+ with_config(cfg): ContextForgeBuilder&lt;br&gt;+ with_stores(lex, vec): ContextForgeBuilder&lt;br&gt;+ with_llm_provider(llm): ContextForgeBuilder&lt;br&gt;+ with_exporter(exp) / with_rule(r)&lt;br&gt;+ build(): ContextForge" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="n_5" value="&lt;b&gt;&amp;lt;&amp;lt;Soporte Interno (Resolución por nombre)&amp;gt;&amp;gt;&lt;br&gt;StrategyFactory &amp; ExporterRegistry&lt;/b&gt;&lt;hr&gt;- _chunkers / _rankers / _exporters&lt;hr&gt;+ get_chunker(name) / get_ranker(name) / get(format)" style="whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="395" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n_7" value="&lt;b&gt;&amp;lt;&amp;lt;GoF Estructural: Facade · API Pública&amp;gt;&amp;gt;&lt;br&gt;ContextForge&lt;/b&gt;&lt;hr&gt;- _config: ContextForgeConfig&lt;br&gt;- _llm_provider: ILLMProvider&lt;br&gt;- _rule_chain: DocumentRuleChain&lt;br&gt;- _event_bus: KnowledgeEventBus&lt;hr&gt;+ ingest(docs, chunking_strategy): IngestionReport&lt;br&gt;+ ingest_directory(dir, pattern): IngestionReport&lt;br&gt;+ search(query, top_k, mode, ranking): list[SearchHit]&lt;br&gt;+ ask(question, top_k, mode, ranking): RagResponse&lt;br&gt;+ compile_bundle(name, max_tokens, fmt): ContextBundle&lt;br&gt;+ register_chunking_strategy(s) / register_ranking_strategy(s)&lt;br&gt;+ register_exporter(e) / register_rule(r) / subscribe(obs)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="635" y="160" width="520" height="275" as="geometry" />
        </mxCell>
        <mxCell id="n_8" value="&lt;b&gt;&amp;lt;&amp;lt;interface · Dependency Inversion (DIP)&amp;gt;&amp;gt;&lt;br&gt;ILLMProvider · ILexicalStore · IVectorStore&lt;/b&gt;&lt;hr&gt;+ provider_name: str  |  + index(chunks)  |  + clear()&lt;hr&gt;+ generate(prompt, system_prompt): str&lt;br&gt;+ search(query, top_k): list[SearchHit]" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1215" y="160" width="615" height="170" as="geometry" />
