        </mxCell>
        <mxCell id="n_4" value="&lt;b&gt;&amp;lt;&amp;lt;GoF: Builder&amp;gt;&amp;gt;&lt;br&gt;ContextForgeBuilder&lt;/b&gt;&lt;hr&gt;- _config: ContextForgeConfig&lt;br&gt;- _lexical_store: ILexicalStore | None&lt;br&gt;- _llm_provider: ILLMProvider | None&lt;hr&gt;+ with_config(cfg): ContextForgeBuilder&lt;br&gt;+ with_stores(lex, vec): ContextForgeBuilder&lt;br&gt;+ with_llm_provider(llm): ContextForgeBuilder&lt;br&gt;+ with_exporter(exp) / with_rule(r)&lt;br&gt;+ build(): ContextForge" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="510" height="195" as="geometry" />
        </mxCell>
        <mxCell id="n_5" value="&lt;b&gt;&amp;lt;&amp;lt;GoF: Factory&amp;gt;&amp;gt;&lt;br&gt;StrategyFactory&lt;/b&gt;&lt;hr&gt;- _chunkers: dict[str, IChunking]&lt;br&gt;- _rankers: dict[str, IRanking]&lt;hr&gt;+ register_chunker(s)&lt;br&gt;+ register_ranker(s)&lt;br&gt;+ get_chunker(name)&lt;br&gt;+ get_ranker(name)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="385" width="245" height="195" as="geometry" />
        </mxCell>
        <mxCell id="n_6" value="&lt;b&gt;&amp;lt;&amp;lt;GoF: Factory / Registry&amp;gt;&amp;gt;&lt;br&gt;RetrieverFactory &amp; ExporterRegistry&lt;/b&gt;&lt;hr&gt;- _lexical: ILexicalStore&lt;br&gt;- _vector: IVectorStore&lt;br&gt;- _exporters: dict[str, IExporter]&lt;hr&gt;+ retrieve(q, top_k, mode, rank)&lt;br&gt;+ register(exporter)&lt;br&gt;+ get(format_name): IBundleExporter" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="385" width="245" height="195" as="geometry" />
        </mxCell>
        <mxCell id="n_8" value="&lt;b&gt;&amp;lt;&amp;lt;GoF: Facade · API Pública&amp;gt;&amp;gt;&lt;br&gt;ContextForge&lt;/b&gt;&lt;hr&gt;- _config: ContextForgeConfig&lt;br&gt;- _decorator: AuditingOperationDecorator&lt;br&gt;- _rule_chain: DocumentRuleChain&lt;br&gt;- _event_bus: KnowledgeEventBus&lt;br&gt;- _llm_provider: ILLMProvider&lt;hr&gt;+ ingest(docs, chunking_strategy): IngestionReport&lt;br&gt;+ ingest_directory(dir, pattern): IngestionReport&lt;br&gt;+ search(query, top_k, mode, ranking): list[SearchHit]&lt;br&gt;+ ask(question, top_k, mode, ranking): RagResponse&lt;br&gt;+ compile_bundle(name, max_tokens, fmt): ContextBundle&lt;br&gt;+ register_chunking_strategy(s) / register_ranking_strategy(s)&lt;br&gt;+ register_exporter(e) / register_rule(r) / subscribe(obs)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B365D;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
