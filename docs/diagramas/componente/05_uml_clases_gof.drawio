        <mxCell id="n_9" value="&lt;b&gt;&amp;lt;&amp;lt;Implementaciones por Defecto (0 deps) y Soporte&amp;gt;&amp;gt;&lt;br&gt;Default Adapters &amp; Utilities&lt;/b&gt;&lt;hr&gt;• InMemoryLexicalStore (BM25)  ..|&gt; ILexicalStore&lt;br&gt;• InMemoryVectorStore (Cosine) ..|&gt; IVectorStore&lt;br&gt;• ExtractiveFallbackLLMProvider ..|&gt; ILLMProvider&lt;hr&gt;• Soporte: AuditingOperationDecorator, DocumentRuleChain, KnowledgeEventBus" style="whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
