        <mxCell id="n_9" value="&lt;b&gt;&amp;lt;&amp;lt;GoF: Decorator&amp;gt;&amp;gt;&lt;br&gt;AuditingOperationDecorator&lt;/b&gt;&lt;hr&gt;- _audit_trail: list[AuditRecord]&lt;hr&gt;+ execute(op, fn, *args): TResult&lt;br&gt;+ records(): list[AuditRecord]&lt;br&gt;• Mide latency_ms y éxitos/fallos" style="whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B21A8;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=left;spacing=8;" vertex="1" parent="1">
