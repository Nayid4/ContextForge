        <mxCell id="n_7" value="&lt;b&gt;Núcleo Privado Encapsulado&lt;/b&gt;&lt;br&gt;[src/contextforge/_internal/]&lt;br&gt;&lt;br&gt;• &lt;b&gt;stores.py&lt;/b&gt;: BM25 + Vector coseno&lt;br&gt;• &lt;b&gt;strategies.py&lt;/b&gt;: Chunking y RRF/Weighted&lt;br&gt;• &lt;b&gt;factories.py&lt;/b&gt;: Strategy &amp; Retriever&lt;br&gt;• &lt;b&gt;exporters.py&lt;/b&gt;: MD, JSON, XML + Registry&lt;br&gt;• &lt;b&gt;rules.py&lt;/b&gt;: DocumentRuleChain&lt;br&gt;• &lt;b&gt;decorators.py&lt;/b&gt;: Auditoría y latencia&lt;br&gt;• &lt;b&gt;events.py&lt;/b&gt;: KnowledgeEventBus&lt;br&gt;• &lt;b&gt;pipelines.py&lt;/b&gt;: RAG + Context Bundler" style="whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;fontColor=#0F172A;fontSize=11;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
