        <mxCell id="n_2" value="&lt;b&gt;Modelo C4 — Nivel 1: Diagrama de Contexto del Sistema (ContextForge)&lt;/b&gt;&lt;br&gt;Reduce la dependencia de conocimiento entre integrantes y permite a servicios externos consultar bases de conocimiento e integrar agentes con IA" style="whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=15;strokeWidth=1.8;align=center;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1">
