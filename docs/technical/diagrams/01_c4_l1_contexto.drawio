        <mxCell id="title_banner" value="&lt;b&gt;Modelo C4 — Nivel 1: Diagrama de Contexto del Sistema (ContextForge)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569'&gt;Actores humanos, integradores externos, componente reutilizable v1.0.0, plataforma v2.1.0 y sistemas externos&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=16;fontColor=#0f172a;" vertex="1" parent="1">
