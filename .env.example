# ==============================================================================
# CONTEXTFORGE — PLANTILLA DE CONFIGURACIÓN (.env — SELF-HOSTED & SECRETOS OCULTOS)
# Copia este archivo a `.env` (ignorado por Git) para mantener tus claves seguras
# sin necesidad de escribirlas en la interfaz web.
# ==============================================================================

# --- 1. Environment & Security Options ---
APP_NAME=ContextForge
APP_VERSION=2.0.0
APP_ENV=local
CONTEXTFORGE_PORT=8000
# AUTH_MODE: local (desarrollo soberano ágil) | enterprise_rbac (exige JWT / X-API-Key)
AUTH_MODE=local
# ALLOW_PUBLIC_CLI_AGENTS: false por defecto (BR-17). Cambia a true solo en pruebas locales si deseas agentes public con CLI en sandbox.
ALLOW_PUBLIC_CLI_AGENTS=false
JWT_SECRET_KEY=change-this-256-bit-secret-in-production-contextforge-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MASTER_VAULT_KEY=change-this-32-byte-master-vault-key-aes256gcm!
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTO_SEED_DATA=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30

# --- 2. Database Options (SQLite WAL por defecto; Postgres/Supabase/Mongo/Firebase opcionales) ---
# DB_PROVIDER: sqlite | postgresql | supabase | sqlserver | mysql | mongodb | firebase
DB_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/database/contextforge.db
DB_POOL_SIZE=10
DB_BUSY_TIMEOUT_MS=5000
CHROMA_PERSIST_DIR=./data/database/chroma
DOCS_ROOT_PATH=./docs

# Opcionales para perfil PostgreSQL (--profile postgres) o nubes externas:
# POSTGRES_USER=cfadmin
# POSTGRES_PASSWORD=cfsecret
# POSTGRES_DB=contextforge
# MONGODB_URL=mongodb://localhost:27017/contextforge
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_PATH=

# --- 3. Multi-LLM & RAG Engine Options (Motores Locales, Cloud API y CLIs) ---
# AI_PROVIDER: ollama | lmstudio | openai | gemini | anthropic | openrouter | deepseek | antigravity_cli | claude_cli | gemini_cli | extractive_fallback
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=llama3.1:8b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30.0
RAG_MIN_GROUNDING_SCORE=0.15
RAG_ENABLE_DLP_REDACTION=true
RAG_ENABLE_EXTRACTIVE_FALLBACK=true

# --- 4. Secretos de Proveedores IA (ocultos en .env; se detectan automáticamente en UI y API) ---
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# OLLAMA_API_KEY=
# LMSTUDIO_API_KEY=

# --- 5. Storage Options (Local FS, AWS S3 / R2, Supabase Storage, Firebase Storage) ---
# STORAGE_PROVIDER: local | aws_s3 | azure_blob | gcs | supabase | firebase
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
MAX_ATTACHMENT_SIZE_MB=25
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
