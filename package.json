{
  "name": "ai-agentic-sdd-engineering-harness",
  "version": "2.5.0",
  "type": "module",
  "description": "Arnés universal y agnóstico de ingeniería de software dirigida por especificaciones (Spec Driven Development) para agentes de IA",
  "main": "project-docs/src/main.js",
  "scripts": {
    "test": "node --test tests/unit/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "build": "npx esbuild project-docs/src/main.js --bundle --outfile=project-docs/dist/app.bundle.js --format=iife",
    "sync": "node project-docs/sync-data.js",
    "start": "node project-docs/serve.js"
  },
  "keywords": [
    "antigravity",
    "sdd",
    "spec-driven-development",
    "ai-agents",
    "harness",
    "opencode",
    "github-copilot"
  ],
  "author": "Google Antigravity & Harness Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
